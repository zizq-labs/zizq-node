<div id="urls">
  <% if (monitoredUrls.length === 0) { %>
    <p class="empty">No URLs being monitored yet. Add one above.</p>
  <% } else { %>
    <table class="urls">
      <thead>
        <tr>
          <th>URL</th>
          <th>Status</th>
          <th>Last checked</th>
        </tr>
      </thead>
      <tbody>
        <% monitoredUrls.forEach(function(m) { %>
          <tr>
            <td class="url"><%= m.url %></td>
            <td>
              <span class="status status-<%= m.lastStatus || 'pending' %>">
                <%= (m.lastStatus || 'pending').toUpperCase() %>
              </span>
            </td>
            <td>
              <% if (m.lastCheckedAt) { %>
                <%= helpers.timeAgo(m.lastCheckedAt) %>
              <% } else { %>
                <em>pending first check</em>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
