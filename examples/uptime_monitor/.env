# Defaults for the Uptime Monitor example app.
#
# This file is committed; override locally in .env.local (gitignored)
# without touching the defaults that everyone else clones.

# Zizq job-queue server.
ZIZQ_URL=http://127.0.0.1:7890

# Web server bind + port.
BIND=127.0.0.1
PORT=3000

# Worker concurrency (max jobs handled in parallel by the embedded
# worker inside the web process). Node's single event loop means this
# is a promise-dispatch limit, not a thread pool.
ZIZQ_WORKER_CONCURRENCY=4

# Where status-transition events are POSTed. Defaults to a public
# request-catcher URL to exercise the full POST path — swap for a
# webhook.site URL to inspect the payloads or trigger retries.
WEBHOOK_URL=https://example.com/webhook

# Stable session secret so browser cookies survive across restarts.
# Override in .env.local (or production env) for real deployments.
SESSION_SECRET=dev_only_replace_in_env_local_for_stable_sessions_across_restarts
