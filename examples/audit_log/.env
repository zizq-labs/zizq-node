# Defaults for the Audit Log example app.
#
# This file is committed; override locally in .env.local (gitignored)
# without touching the defaults that everyone else clones. Node loads
# these via `--env-file` in the npm scripts (Node 20.6+).

# Zizq job-queue server.
ZIZQ_URL=http://127.0.0.1:7890

# Web server bind + port.
BIND=127.0.0.1
PORT=3000

# Worker concurrency (max jobs handled in parallel by the worker
# process). Node handles I/O-bound work on a single event loop, so
# this is a promise-dispatch limit — no thread pool involved.
ZIZQ_WORKER_CONCURRENCY=25
